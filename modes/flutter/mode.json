{
  "id": "flutter",
  "name": "Flutter 应用",
  "description": "从一句想法到可运行的 Flutter 应用：SPEC 驱动开发、真机实测、视觉验收",
  "icon": "smartphone",
  "starters": [
    {
      "label": "从想法建 App",
      "prompt": "我想做一个 App："
    },
    {
      "label": "加一个功能",
      "prompt": "给当前 App 加一个新功能："
    },
    {
      "label": "修复问题",
      "prompt": "当前 App 有一个问题需要修复："
    },
    {
      "label": "真机测试",
      "prompt": "把 App 部署到手机跑一遍测试，并给我一份测试报告。"
    }
  ],
  "prompts": "flutter",
  "plugins": [
    "flutter-dev",
    "orchestration",
    "android-device",
    "vision",
    "explore"
  ],
  "scaffold": "flutter-app",
  "projectFields": [
    {
      "id": "name",
      "label": "项目名称",
      "type": "text",
      "required": true,
      "placeholder": "例如：记账小助手"
    },
    {
      "id": "dir",
      "label": "项目目录",
      "type": "folder",
      "required": true,
      "placeholder": "选择一个空目录"
    },
    {
      "id": "idea",
      "label": "产品想法",
      "type": "textarea",
      "required": true,
      "placeholder": "想做一个什么样的 App？核心功能是什么？",
      "hint": "开始对话后也可以继续补充"
    },
    {
      "id": "kind",
      "label": "应用形态",
      "type": "choice",
      "default": "app",
      "options": [
        {
          "value": "app",
          "label": "纯移动 App"
        },
        {
          "value": "go",
          "label": "App + Go 后端"
        }
      ]
    }
  ]
}
